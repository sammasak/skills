#!/usr/bin/env bash
# Repo pre-push gate: the hook suite must be green before hooks ship.
# The nix shell supplies shellcheck/yq so their cases RUN here rather than
# silently skipping (the suite skips tools it cannot find).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
# no-force-guard v5: refuse non-fast-forward pushes, deletion of
# refs/heads/main|master, and a push that brings new commits to more than
# one ref (prek gates only the first such ref), on git's own stdin
# (<local ref> <local sha> <remote ref> <remote sha> per line).
# Single source of truth for this block — manual .githooks copies in
# nixos-config/claude-code-skills/homelab-gitops/knowledge carry the text of
# the platform version they pin and move with their pin bump.
# Bump the version marker on ANY behavioral change.
stdin=$(cat)
zeros=0000000000000000000000000000000000000000
printf '%s\n' "$stdin" | {
  while read -r _ lsha rref rsha; do
    [ -z "$rsha" ] && continue
    [ "$rsha" = "$zeros" ] && continue
    if [ "$lsha" = "$zeros" ]; then
      case "$rref" in refs/heads/main|refs/heads/master)
        echo "pre-push: deleting $rref on the remote is refused." >&2; exit 1 ;;
      esac
      continue
    fi
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      echo "pre-push: non-fast-forward to $rref refused (force push, or your view of the remote is stale — fetch first); revert with a new commit or push a branch." >&2
      exit 1
    fi
  done
} || exit 1
printf '%s\n' "$stdin" | {
  n=0
  while read -r _ lsha _ rsha; do
    [ -z "$rsha" ] && continue
    [ "$lsha" = "$zeros" ] && continue
    [ "$lsha" = "$rsha" ] && continue
    if [ "$rsha" = "$zeros" ] && new=$(git rev-list -n 1 "$lsha" --not --remotes="$1" 2>/dev/null) && [ -z "$new" ]; then
      continue
    fi
    n=$((n + 1))
  done
  if [ "$n" -gt 1 ]; then
    echo "pre-push: this push brings new commits to $n refs, but only the first would be gated; push one ref at a time (a branch first, then its tag)." >&2
    exit 1
  fi
} || exit 1
cd "$(git rev-parse --show-toplevel)"
nix shell nixpkgs#shellcheck nixpkgs#yq-go --command bash tests/test-hooks.sh
bash tests/test-shunt.sh
bash tests/test-work-ref.sh
bash tests/test-skill-use.sh
