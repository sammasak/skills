#!/usr/bin/env bash
# herdr:inventory — every agent on every fleet host, as record schema v1.
# Usage: herdr-inventory [--fleet FILE] [--host NAME] [--timeout-s N] [--max-age-s N]
# Exit: 0 at least one host answered (partial=true if any failed), 2 none, 3 bad input.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/../lib.sh"

fleet_arg="" only_host="" timeout_s=8 max_age_s=120
while [ $# -gt 0 ]; do
  case "$1" in
    --fleet) fleet_arg="$2"; shift 2 ;;
    --host) only_host="$2"; shift 2 ;;
    --timeout-s) timeout_s="$2"; shift 2 ;;
    --max-age-s) max_age_s="$2"; shift 2 ;;
    *) die 3 invalid_argument "unknown argument: $1" ;;
  esac
done
[[ "$timeout_s" =~ ^[0-9]+$ && "$max_age_s" =~ ^[0-9]+$ ]] || die 3 invalid_argument "timeouts must be integers"

fleet=$(load_fleet "$(fleet_file "$fleet_arg")")
if [ -n "$only_host" ]; then
  valid_id "$only_host" || die 3 invalid_argument "host name rejected"
  jq -e --arg h "$only_host" '.hosts[] | select(.name == $h)' <<<"$fleet" >/dev/null || die 3 unknown_host "host not in fleet: $only_host"
fi

snap_dir="$(state_dir)/herdr"; mkdir -p "$snap_dir"
observed_at=$(now_iso); now=$(now_epoch)
hosts_out="[]"; answered=0; failed=0

# to_records <host> <raw-list-json> <prev-snapshot-json> -> records json array
to_records() {
  jq -c --arg host "$1" --arg at "$observed_at" --argjson now "$now" --argjson prev "$3" '
    .result.agents // [] | map(
      ($prev[.pane_id] // null) as $p
      | (if $p != null and $p.state_change_seq == .state_change_seq then $p.since else $now end) as $since
      | {host: $host, server: $host, agent_id: .pane_id, harness: .agent,
         session_id: (.agent_session.value // null), cwd: .cwd,
         title: (.terminal_title_stripped // .terminal_title // ""),
         observed_state: .agent_status, observed_at: $at,
         state_age_s: ($now - $since), state_change_seq: .state_change_seq, since: $since,
         stale: false,
         task_ref: ((.terminal_title_stripped // "") | capture("(?<r>#[0-9]+)")?.r // null),
         evidence_ref: null,
         approval_required: (.agent_status == "blocked"),
         error: null})' <<<"$2"
}

while IFS=$'\t' read -r name target; do
  [ -z "$only_host" ] || [ "$name" = "$only_host" ] || continue
  snap="$snap_dir/$name.json"
  prev="{}"; [ -r "$snap" ] && prev=$(jq -c '.by_id // {}' "$snap" 2>/dev/null || echo "{}")
  err="null"; reachable=true; records="[]"
  set +e
  raw=$(run_on_host "$timeout_s" "$target" herdr agent list 2>/dev/null); rc=$?
  set -e
  case "$rc" in
    0) if records=$(to_records "$name" "$raw" "$prev" 2>/dev/null) && jq -e 'type=="array"' <<<"$records" >/dev/null; then
         answered=$((answered+1))
         jq -cn --arg at "$observed_at" --argjson r "$records" \
           '{observed_at:$at, by_id: ($r | map({key:.agent_id, value:{state_change_seq, since, record:.}}) | from_entries)}' > "$snap"
       else err='{"kind":"malformed","message":"herdr agent list did not return an agent_list"}'; reachable=false; fi ;;
    124) err='{"kind":"timeout","message":"no answer within '"$timeout_s"'s"}'; reachable=false ;;
    255) err='{"kind":"unreachable","message":"ssh could not connect"}'; reachable=false ;;
    *) err='{"kind":"command_failed","message":"herdr agent list exited '"$rc"'"}'; reachable=false ;;
  esac
  if [ "$reachable" = false ]; then
    failed=$((failed+1)); records="[]"
    if [ -r "$snap" ]; then
      records=$(jq -c --argjson now "$now" --argjson max "$max_age_s" '
        (.observed_at | fromdateiso8601) as $t
        | if ($now - $t) > $max then [] else
            [.by_id[].record | .stale = true | .snapshot_at = (.observed_at) | .snapshot_age_s = ($now - $t)]
          end' "$snap" 2>/dev/null || echo "[]")
      [ "$records" != "[]" ] || err=$(jq -c --argjson max "$max_age_s" '.message += "; last snapshot older than \($max)s, discarded"' <<<"$err")
    fi
  fi
  hosts_out=$(jq -c --arg h "$name" --arg s "$target" --argjson re "$reachable" --argjson e "$err" --argjson r "$records" \
    '. + [{host:$h, ssh:(if $s=="null" then null else $s end), reachable:$re, error:$e, agents:$r}]' <<<"$hosts_out")
done < <(jq -r '.hosts[] | [.name, (.ssh // "null")] | @tsv' <<<"$fleet")

jq -n --arg at "$observed_at" --argjson hosts "$hosts_out" --argjson partial "$([ "$failed" -gt 0 ] && echo true || echo false)" \
  '{schema_version:1, task:"herdr:inventory", observed_at:$at, partial:$partial, hosts:$hosts}' | tee "${DEVENV_TASK_OUTPUT_FILE:-/dev/null}"
[ "$answered" -gt 0 ] || exit 2
